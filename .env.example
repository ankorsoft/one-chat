# Application Settings
APP_NAME=onechat
APP_ENV=development
DEBUG=true

# Database
POSTGRES_USER=onechat
POSTGRES_PASSWORD=onechat_secret_change_in_prod
POSTGRES_DB=onechat
DATABASE_URL=postgresql+asyncpg://onechat:onechat_secret_change_in_prod@postgres:5432/onechat

# Redis
REDIS_PASSWORD=redis_secret_change_in_prod
REDIS_URL=redis://:redis_secret_change_in_prod@redis:6379/0

# MinIO/S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret_change_in_prod
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_change_in_prod
MINIO_BUCKET=onechat-media
MINIO_USE_SSL=false

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PEPPER=another_secret_pepper_value_change_in_prod

# CSRF
CSRF_SECRET_KEY=csrf_secret_key_change_in_prod

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Prometheus
PROMETHEUS_ENABLED=true

# Rate Limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Channel API Keys (set in production)
TELEGRAM_BOT_TOKEN=
VK_GROUP_ID=
VK_GROUP_SECRET=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
MAX_BOT_TOKEN=

# Feature Flags
FEATURE_TELEGRAM=true
FEATURE_VK=true
FEATURE_WHATSAPP=true
FEATURE_MAX=true
